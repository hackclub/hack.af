# Express
PORT=3000

# Logging (on/off, on by default/if not "off")
LOGGING=on
BOT_LOGGING=on

# Slack Tokens (optional)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Postgres
DATABASE_URL=postgresql://hackaf:hackaf@localhost:5432/hackaf?schema=public

# Graphite (optional)
GRAPHITE_HOST=

# Cache Size + TTL in seconds (short link records count in memory)
CACHE_SIZE=500
CACHE_TTL=60
# Postgres pool size (optional, default 10)
DATABASE_POOL_SIZE=10

# Short link domain shown in the dashboard and bot replies (default hack.club)
SHORT_DOMAIN=hack.club

# Dashboard (manage.hack.club). Leave MANAGE_HOST unset to turn the dashboard off.
# Comma-separate extra hosts; the first one is used for the Hack Club Auth callback.
MANAGE_HOST=manage.hack.club
# Signs the dashboard session cookie. Required in production.
MANAGE_SESSION_SECRET=
# Hack Club Auth OIDC app (auth.hackclub.com → Developer Apps).
# Redirect URI: https://<MANAGE_HOST>/auth/hca/callback, scopes: openid profile email slack_id
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Break-glass admins who always have access (Slack IDs or emails, comma-separated)
MANAGE_BOOTSTRAP_ADMINS=
# Slack channel ID that gets a message whenever someone is added to or removed from the allowlist
STAFF_AUDIT_CHANNEL=

# Local development only: sign in without Hack Club Auth
# MANAGE_DEV_LOGIN=1
# MANAGE_DEV_LOGIN_AS=U0ORPHEUS1
